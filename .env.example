APP_NAME="Rahbar Hesab"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=rahbarhesabsite
# DB_USERNAME=root
# DB_PASSWORD=

# مهاجرت وردپرس (بکاپ، نه دیتابیس لایو)
# WP_DB_HOST=127.0.0.1
# WP_DB_PORT=3306
# WP_DB_DATABASE=
# WP_DB_USERNAME=
# WP_DB_PASSWORD=
# WP_DB_PREFIX=wp_

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_STORE=redis
# REDIS_HOST=127.0.0.1

# پروداکشن: php artisan queue:work --tries=3
# پروداکشن: * * * * * php artisan schedule:run

CMS_SITE_NAME="Rahbar Hesab"
CMS_SITE_NAME_FA="راهبر حساب"
CMS_ACTIVE_THEME=rahbarhesab
CMS_ADMIN_EMAIL=admin@rahbarhesab.ir
CMS_ADMIN_PASSWORD=secret
CMS_API_TOKEN=
CMS_LOGO=/images/rahbarhesab/logo-full.png
CMS_FAVICON=/images/rahbarhesab/logo-full.png
CMS_OG_IMAGE=/themes/rahbarhesab/og-image.png
CMS_ENROLLMENT_MONTHS=12

CMS_PAYMENT_GATEWAY=zibal
# سندباکس زیبال: zibal — پروداکشن: مرچنت واقعی
ZIBAL_MERCHANT=zibal
# ZARINPAL_MERCHANT_ID=
# ZARINPAL_SANDBOX=true

IPPANEL_API_KEY=
IPPANEL_OTP_PATTERN=
IPPANEL_SENDER=+983000505
IPPANEL_BASE_URL=https://api2.ippanel.com/api/v1

SPOTPLAYER_API_KEY=
SPOTPLAYER_BASE_URL=https://api.spotplayer.ir
SPOTPLAYER_PLAYER_URL=https://app.spotplayer.ir
SPOTPLAYER_DEVICES_LIMIT=2
